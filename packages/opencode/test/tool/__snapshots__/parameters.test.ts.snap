exports[`tool parameters JSON Schema (wire shape) send_message 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "message": {
      "anyOf": [
        {
          "type": "string",
        },
        {
          "anyOf": [
            {
              "properties": {
                "reason": {
                  "type": "string",
                },
                "request_id": {
                  "type": "string",
                },
                "type": {
                  "const": "shutdown_request",
                  "type": "string",
                },
              },
              "required": [
                "type",
              ],
              "type": "object",
            },
            {
              "properties": {
                "approve": {
                  "type": "boolean",
                },
                "reason": {
                  "type": "string",
                },
                "request_id": {
                  "type": "string",
                },
                "type": {
                  "const": "shutdown_response",
                  "type": "string",
                },
              },
              "required": [
                "type",
                "request_id",
                "approve",
              ],
              "type": "object",
            },
            {
              "properties": {
                "plan": {
                  "type": "string",
                },
                "plan_file_path": {
                  "type": "string",
                },
                "request_id": {
                  "type": "string",
                },
                "type": {
                  "const": "plan_approval_request",
                  "type": "string",
                },
              },
              "required": [
                "type",
                "plan",
              ],
              "type": "object",
            },
            {
              "properties": {
                "approve": {
                  "type": "boolean",
                },
                "feedback": {
                  "type": "string",
                },
                "request_id": {
                  "type": "string",
                },
                "type": {
                  "const": "plan_approval_response",
                  "type": "string",
                },
              },
              "required": [
                "type",
                "request_id",
                "approve",
              ],
              "type": "object",
            },
            {
              "properties": {
                "always": {
                  "type": "boolean",
                },
                "approve": {
                  "type": "boolean",
                },
                "reason": {
                  "type": "string",
                },
                "request_id": {
                  "type": "string",
                },
                "type": {
                  "const": "permission_response",
                  "type": "string",
                },
              },
              "required": [
                "type",
                "request_id",
                "approve",
              ],
              "type": "object",
            },
            {
              "properties": {
                "directory_path": {
                  "type": "string",
                },
                "rules": {
                  "items": {
                    "properties": {
                      "action": {
                        "enum": [
                          "allow",
                          "deny",
                          "ask",
                        ],
                        "type": "string",
                      },
                      "pattern": {
                        "type": "string",
                      },
                      "permission": {
                        "type": "string",
                      },
                    },
                    "required": [
                      "permission",
                      "pattern",
                      "action",
                    ],
                    "type": "object",
                  },
                  "type": "array",
                },
                "tool_name": {
                  "type": "string",
                },
                "type": {
                  "const": "team_permission_update",
                  "type": "string",
                },
              },
              "required": [
                "type",
                "rules",
              ],
              "type": "object",
            },
            {
              "properties": {
                "mode": {
                  "enum": [
                    "default",
                    "ask",
                    "accept_edits",
                    "acceptEdits",
                    "bypass_permissions",
                    "bypassPermissions",
                    "read_only",
                    "readonly",
                  ],
                  "type": "string",
                },
                "type": {
                  "const": "mode_set_request",
                  "type": "string",
                },
              },
              "required": [
                "type",
                "mode",
              ],
              "type": "object",
            },
          ],
        },
      ],
      "description": "The message to send. Can be plain text or a structured protocol object such as shutdown_request, shutdown_response, plan_approval_request, plan_approval_response, permission_response, team_permission_update, or mode_set_request.",
    },
    "summary": {
      "description": "A short 5-10 word summary of the message for status displays.",
      "type": "string",
    },
    "team": {
      "description": "Team name to broadcast to when to is "*".",
      "type": "string",
    },
    "to": {
      "description": "The target subagent worker_id, task_id/session_id, launch name, "session:<session_id>" for a same-project peer session, or "*" to broadcast to a team.",
      "type": "string",
    },
  },
  "required": [
    "to",
    "message",
  ],
  "type": "object",
}
`;

