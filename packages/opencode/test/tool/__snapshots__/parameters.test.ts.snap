exports[`tool parameters JSON Schema (wire shape) schedule_task 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "cron": {
      "description": "Standard 5-field cron expression in local time: "M H DoM Mon DoW" (for example "*/5 * * * *" or "30 14 28 2 *").",
      "type": "string",
    },
    "durable": {
      "description": "true persists to .opencode/scheduled_tasks.json and survives restarts. false (default) is in-memory for this opencode process only.",
      "type": "boolean",
    },
    "prompt": {
      "description": "The prompt to enqueue when the schedule fires.",
      "type": "string",
    },
    "recurring": {
      "description": "true (default) fires on every cron match until deleted or auto-expired. false fires once at the next match, then deletes itself.",
      "type": "boolean",
    },
    "to": {
      "description": "Optional target subagent worker_id, session_id, or launch name. Omit to target the current session; from inside a subagent, omit to target that subagent.",
      "type": "string",
    },
  },
  "required": [
    "cron",
    "prompt",
  ],
  "type": "object",
}
`;

