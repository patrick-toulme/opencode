    "command": {
      "description": "The command that triggered this task",
      "type": "string",
    },
    "context": {
      "description": "Controls how much parent conversation context the subagent inherits. Use "fresh" for self-contained delegated work. Use "fork" only when the full parent conversation is required as background.",
      "enum": [
        "auto",
        "fork",
        "fresh",
      ],
      "type": "string",
    },
    "cwd": {
      "description": "Absolute or relative working directory override for the subagent. Do not set this together with isolation; if both are provided, cwd takes precedence and isolation is ignored.",
      "type": "string",
    },
    "description": {
      "description": "A short (3-5 words) description of the task",
      "type": "string",
    },
    "isolation": {
      "description": "Usually omit. Set "worktree" only for isolated file edits, or "remote" only when remote execution is explicitly required/configured. For read-only research, omit isolation.",
      "enum": [
        "worktree",
        "remote",
      ],
      "type": "string",
    },
    "mode": {
      "const": "plan",
      "description": "Compatibility spawn mode alias. Set to "plan" only for implementation work that needs approval gating; omit for read-only research/explore tasks.",
      "type": "string",
    },
    "model": {
      "description": "Optional model override in "provider/model" form. When omitted, the subagent configured model or parent model is used.",
      "type": "string",
    },
    "name": {
      "description": "Optional name for a background subagent. This makes it addressable with the send_message tool while it is running.",
      "type": "string",
    },
    "plan_mode_required": {
      "description": "Set true only for implementation subagents that must receive team-lead approval before mutating files or running shell commands. Set false for read-only research.",
      "type": "boolean",
    },
    "prompt": {
      "description": "The task for the agent to perform",
      "type": "string",
    },
    "run_in_background": {
      "description": "Compatibility field. Model-facing subagents run in the background; only trusted internal callers may set this to false for synchronous execution.",
      "type": "boolean",
    },
    "subagent_type": {
      "description": "The type of specialized agent to use for a fresh subagent. Omit this to fork yourself with inherited context.",
      "type": "string",
    },
    "task_id": {
      "description": "This should only be set if you mean to resume a previous task (you can pass a prior task_id and the task will continue the same subagent session as before instead of creating a fresh one)",
      "type": "string",
    },
    "team": {
      "description": "Optional team name for coordinating multiple background subagents. Agents in the same team can receive broadcast messages.",
      "type": "string",
    },
    "team_name": {
      "description": "Compatibility alias for team.",
      "type": "string",
    },
  },
  "required": [
    "description",
    "prompt",
  ],
  "type": "object",
}
`;

